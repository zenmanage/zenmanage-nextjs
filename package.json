{
  "name": "@zenmanage/nextjs",
  "version": "1.0.0",
  "description": "Next.js integration helpers for Zenmanage feature flags: server evaluation, middleware, and hydration-safe client bootstrap",
  "keywords": [
    "nextjs",
    "next.js",
    "react",
    "ssr",
    "app-router",
    "pages-router",
    "middleware",
    "feature-flags",
    "feature-toggles",
    "feature-management",
    "remote-config",
    "ab-testing",
    "experiments",
    "zenmanage"
  ],
  "homepage": "https://github.com/zenmanage/zenmanage-nextjs#readme",
  "bugs": {
    "url": "https://github.com/zenmanage/zenmanage-nextjs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zenmanage/zenmanage-nextjs.git"
  },
  "license": "MIT",
  "author": "Zenmanage",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/server.cjs"
      }
    },
    "./middleware": {
      "import": {
        "types": "./dist/middleware.d.ts",
        "default": "./dist/middleware.js"
      },
      "require": {
        "types": "./dist/middleware.d.cts",
        "default": "./dist/middleware.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      },
      "require": {
        "types": "./dist/client.d.cts",
        "default": "./dist/client.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsup",
    "clean": "rm -rf dist coverage",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "lint": "eslint src tests --ext .ts,.tsx",
    "lint:fix": "eslint src tests --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" \"examples/**/*.{ts,tsx}\" \"examples/smoke-app/**/*.{js,jsx}\" \"scripts/**/*.mjs\" \"*.{md,json,yml,yaml,cjs}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" \"examples/**/*.{ts,tsx}\" \"examples/smoke-app/**/*.{js,jsx}\" \"scripts/**/*.mjs\" \"*.{md,json,yml,yaml,cjs}\"",
    "type-check": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.examples.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "npm run build && node scripts/smoke.mjs",
    "validate": "npm run format:check && npm run lint && npm run type-check && npm run test:coverage && npm run build && npm run test:smoke",
    "prepublishOnly": "npm run validate"
  },
  "peerDependencies": {
    "@zenmanage/react": "^1.0.0",
    "@zenmanage/sdk": "^3.5.0",
    "next": "^13.4.0 || ^14.0.0 || ^15.0.0 || ^16.0.0",
    "react": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.28.1",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^20.11.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript-eslint/eslint-plugin": "^6.20.0",
    "@typescript-eslint/parser": "^6.20.0",
    "@vitest/coverage-v8": "^1.6.0",
    "@zenmanage/react": "^1.0.0",
    "@zenmanage/sdk": "^3.5.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "jsdom": "^24.1.1",
    "next": "^15.5.0",
    "prettier": "^3.3.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsup": "^8.2.4",
    "typescript": "^5.6.2",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
