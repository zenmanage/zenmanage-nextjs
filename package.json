{
  "name": "@zenmanage/nextjs",
  "version": "0.1.0",
  "description": "Next.js integration helpers for Zenmanage feature flags",
  "keywords": [
    "nextjs",
    "next.js",
    "react",
    "ssr",
    "feature-flags",
    "feature-toggles",
    "ab-testing",
    "zenmanage"
  ],
  "homepage": "https://github.com/zenmanage/zenmanage-nextjs#readme",
  "bugs": {
    "url": "https://github.com/zenmanage/zenmanage-nextjs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zenmanage/zenmanage-nextjs.git"
  },
  "license": "MIT",
  "author": "Zenmanage",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./middleware": {
      "types": "./dist/middleware.d.ts",
      "import": "./dist/middleware.js",
      "require": "./dist/middleware.cjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist coverage",
    "lint": "eslint src tests --ext .ts,.tsx",
    "lint:fix": "eslint src tests --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" \"examples/**/*.{ts,tsx}\" \"*.{md,json,yml,yaml,cjs}\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" \"examples/**/*.{ts,tsx}\" \"*.{md,json,yml,yaml,cjs}\" \"docs/**/*.md\"",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "validate": "npm run format:check && npm run lint && npm run type-check && npm run test:coverage && npm run build",
    "prepublishOnly": "npm run validate"
  },
  "dependencies": {},
  "peerDependencies": {
    "@zenmanage/react": "^0.1.0",
    "@zenmanage/sdk": "^3.0.1",
    "next": "^13.4.0 || ^14.0.0 || ^15.0.0",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@zenmanage/react": "file:../zenmanage-react",
    "@zenmanage/sdk": "file:../zenmanage-javascript",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^6.20.0",
    "@typescript-eslint/parser": "^6.20.0",
    "@vitest/coverage-v8": "^1.6.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "jsdom": "^24.1.1",
    "prettier": "^3.3.3",
    "tsup": "^8.2.4",
    "typescript": "^5.6.2",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
